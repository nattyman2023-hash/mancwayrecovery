# =====================================================================
#  MancWay — root-level router
#  Deployment (git/Hostinger) clones this whole repo into public_html,
#  but the actual document root content lives in public/. This file
#  transparently routes every request into public/ without exposing
#  /public/ in the URL, so app/, database/, .git etc. stay unreachable
#  over HTTP without needing a custom Hostinger document-root setting.
# =====================================================================

DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS first, on the original (pre-rewrite) URI, so canonical
    # URLs stay clean without /public/ in them.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Clean, indexable URLs for the sitemap, services and dedicated locations.
    RewriteRule ^sitemap\.xml$ public/sitemap.xml.php [L]
    RewriteRule ^areas/?$ public/areas.php [L]
    RewriteRule ^areas/([a-z0-9-]+)/?$ public/areas.php?slug=$1 [L,QSA]
    RewriteRule ^services/?$ public/services.php [L]
    RewriteRule ^services/([a-z0-9-]+)/?$ public/service.php?slug=$1 [L,QSA]
    RewriteRule ^invoice/?$ public/invoice.php [L]

    # Route everything through public/ without exposing it in the URL.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
